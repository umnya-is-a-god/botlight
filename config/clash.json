{
    "tcp-concurrent": true,
    "find-process-mode": "always",
    "authentication": [
        "123:321"
    ],
    "mode": "rule",
    "log-level": "info",
    "ipv6": false,
    "keep-alive-interval": 60,
    "unified-delay": false,
    "profile": {
        "store-selected": true,
        "store-fake-ip": true
    },
    "sniffer": {
        "enable": true,
        "sniff": {
            "HTTP": {
                "ports": [
                    80,
                    "8080-8880"
                ],
                "override-destination": true
            },
            "TLS": {
                "ports": [
                    443,
                    8443
                ]
            },
            "QUIC": {
                "ports": [
                    443,
                    8443
                ]
            }
        }
    },
    "tun": {
        "enable": true,
        "stack": "mixed",
        "dns-hijack": [
            "any:53"
        ],
        "auto-route": true,
        "auto-detect-interface": true,
        "strict-route": true
    },
    "hosts": {
        "~domain~": "~ip~"
    },
    "dns": {
        "enable": true,
        "prefer-h3": false,
        "ipv6": false,
        "enhanced-mode": "fake-ip",
        "fake-ip-filter": [
            "~domain~",
            "+.lan",
            "+.local"
        ],
        "nameserver": [
            "~dns~"
        ]
    },
    "proxies": [
        {
            "name": "~outbound~",
            "type": "vless",
            "server": "~domain~",
            "port": 443,
            "uuid": "~uid~",
            "network": "tcp",
            "flow": "xtls-rprx-vision",
            "udp": true,
            "tls": true,
            "reality-opts": {
                "public-key": "~public_key~",
                "short-id": "~short_id~"
            },
            "servername": "~server_name~",
            "client-fingerprint": "firefox"
        }
    ],
    "proxy-groups": [
        {
            "name": "PROXY",
            "type": "select",
            "proxies": [
                "~outbound~"
            ]
        }
    ],
    "add-rule-providers": true,
    "rule-providers": {
        "tun0guard": {
            "type": "inline",
            "behavior": "classical",
            "payload": [
                "NOT,((PROCESS-NAME-REGEX,.+))"
            ]
        },
        "pcgate": {
            "type": "inline",
            "behavior": "classical",
            "payload": [
                "AND,((PROCESS-NAME-WILDCARD,*.exe),(NOT,((OR,((PROCESS-NAME,firefox.exe),(PROCESS-NAME,msedgewebview2.exe),(PROCESS-NAME,claude.exe),(PROCESS-NAME,chatgpt.exe),(PROCESS-NAME,spotify.exe),(PROCESS-NAME,whatsapp.exe),(PROCESS-NAME,figma.exe),(PROCESS-NAME,codex.exe),(PROCESS-NAME,Discord.exe),(PROCESS-NAME,chrome.exe),(PROCESS-NAME,Telegram.exe),(PROCESS-NAME,CitrixReceiverUpdater.exe))))))"
            ]
        }
    },
    "rules": [
        {
            "type": "RULE-SET",
            "name": "tun0guard",
            "action": "REJECT"
        },
        {
            "type": "RULE-SET",
            "list": "~block~",
            "action": "REJECT",
            "interval": 60,
            "behavior": "classical",
            "name": "block"
        },
        {
            "type": "RULE-SET",
            "name": "pcgate",
            "action": "DIRECT"
        },
        {
            "type": "RULE-SET",
            "list": "~process~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "process"
        },
        {
            "type": "RULE-SET",
            "list": "~package~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "package"
        },
        {
            "type": "RULE-SET",
            "list": "~warp~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "warp"
        },
        {
            "type": "RULE-SET",
            "list": "~pac~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "pac"
        },
        {
            "type": "RULE-SET",
            "list": "~subnet~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "subnet"
        },
        {
            "type": "MATCH",
            "action": "DIRECT"
        }
    ]
}