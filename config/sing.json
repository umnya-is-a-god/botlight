{
    "log": {
        "level": "error",
        "timestamp": true
    },
    "inbounds": [
        {
            "type": "tun",
            "tag": "tun-in",
            "address": [
                "172.19.0.1/28",
                "fdfe:dcba:9876::1/126"
            ],
            "mtu": 1400,
            "auto_route": true,
            "strict_route": true,
            "stack": "mixed"
        }
    ],
    "dns": {
        "servers": [
            {
                "type": "hosts",
                "tag": "dns-hosts",
                "predefined": {
                    "~domain~": "~ip~"
                }
            },
            {
                "type": "https",
                "tag": "dns_direct",
                "server": "~domain~",
                "path": "~dnspath~",
                "domain_resolver": "dns-hosts"
            }
        ],
        "final": "dns_direct",
        "strategy": "ipv4_only"
    },
    "outbounds": [
        {
            "type": "vless",
            "tag": "~outbound~",
            "server": "~domain~",
            "server_port": 443,
            "domain_resolver": "dns-hosts",
            "uuid": "~uid~",
            "flow": "xtls-rprx-vision",
            "tls": {
                "enabled": true,
                "reality": {
                    "enabled": true,
                    "public_key": "~public_key~",
                    "short_id": "~short_id~"
                },
                "server_name": "~server_name~",
                "utls": {
                    "enabled": true,
                    "fingerprint": "chrome"
                }
            }
        },
        {
            "type": "direct",
            "tag": "direct"
        }
    ],
    "route": {
        "auto_detect_interface": true,
        "default_domain_resolver": {
            "server": "dns_direct",
            "strategy": "ipv4_only"
        },
        "rules": [
            {
                "action": "sniff"
            },
            {
                "protocol": "dns",
                "action": "hijack-dns"
            },
            {
                "domain": "~domain~",
                "action": "route",
                "outbound": "direct"
            },
            {
                "action": "resolve",
                "strategy": "ipv4_only"
            },
            {
                "addruleset": true,
                "createruleset": [
                    {
                        "name": "block",
                        "interval": "30s",
                        "rules": [
                            {
                                "domain_suffix": "~block~"
                            }
                        ]
                    }
                ],
                "action": "reject"
            },
            {
                "addruleset": true,
                "outbound": "direct"
            },
            {
                "addruleset": true,
                "createruleset": [
                    {
                        "name": "pac",
                        "interval": "30s",
                        "rules": [
                            {
                                "domain_suffix": "~pac~"
                            }
                        ]
                    }
                ],
                "outbound": "~outbound~"
            },
            {
                "addruleset": true,
                "createruleset": [
                    {
                        "name": "warp",
                        "interval": "30s",
                        "rules": [
                            {
                                "domain_suffix": "~warp~"
                            }
                        ]
                    }
                ],
                "outbound": "~outbound~"
            }
        ],
        "final": "direct"
    },
    "experimental": {
        "cache_file": {
            "enabled": true,
            "path": "cache.db",
            "store_dns": true
        }
    }
}
