TZ=Europe/Samara
IMAGE=alpine:3.24
# "latest": the newest Xray release at least 3 days old on every build; or a tag like v26.9.30
XRAY_VERSION=latest
IP=
VER=
TELEGRAM_API=api.telegram.org
ENV=/system/profile
# docker-compose.ports.yml is generated by scripts/ports.sh from the bot's port switches
COMPOSE_FILE=docker-compose.yml:docker-compose.ports.yml:docker-compose.override.yml
